generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// COMPANY
// ==========================================

model Company {
  id              String   @id @default(cuid())
  name            String
  registrationNo  String?  @unique
  industry        String   @default("General") // Construction, IT, Healthcare, Supply, Consulting, etc.
  tinNumber       String?  @unique
  address         String?
  city            String?
  country         String   @default("Ethiopia")
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  verified        Boolean  @default(false)
  status          String   @default("active") // active, suspended
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users     User[]
  profiles  Profile[]
  documents Document[]
  tenders   Tender[]
  projects  Project[]
  tasks     Task[]
}

// ==========================================
// USER & AUTHENTICATION (3-tier roles)
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("user") // super_admin, team_admin, user
  companyId     String?
  status        String    @default("active") // active, suspended, banned
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id])
  profile   Profile?
  documents Document[]
  bids      Bid[]
  messages  Message[]
  registrations Registration[]
  conversationMemberships ConversationMember[]
  chatMessages ChatMessage[]
  messageReactions MessageReaction[]
  assignedTasks Task[]
}

// ==========================================
// PROFILE (KYC Lite)
// ==========================================

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  companyId     String?
  fullName      String
  jobTitle      String?  // CEO, Manager, Engineer, etc.
  phone         String?
  location      String?
  address       String?
  tinNumber     String?
  licenseNumber String?
  skillTags     String  @default("") // comma-separated
  bio           String?
  logoUrl       String?
  profilePhoto  String?
  verified      Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
}

// ==========================================
// DOCUMENT VAULT
// ==========================================

model Document {
  id          String   @id @default(cuid())
  userId      String?
  companyId   String?
  docType     String   // business_license, tax_clearance, portfolio, certificate, other
  fileUrl     String
  fileName    String
  status      String   @default("pending") // pending, approved, rejected
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
}

// ==========================================
// TENDER
// ==========================================

model Tender {
  id            String   @id @default(cuid())
  title         String
  scope         String   // rich text description
  budgetMin     Float
  budgetMax     Float
  deadline      DateTime
  location      String
  categoryTags  String   // comma-separated: Construction, IT, Supply, Consulting, etc.
  requiredDocs  String   @default("") // comma-separated doc types
  status        String   @default("open") // draft, open, closed, awarded, cancelled
  createdBy     String   // admin user id
  companyId     String?  // company isolation: which company created this tender
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bids          Bid[]
  project       Project?
  bidAnalysis   BidAnalysis[]
  company       Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ==========================================
// BID
// ==========================================

model Bid {
  id                String   @id @default(cuid())
  tenderId          String
  userId            String
  technicalProposal String   // rich text
  financialProposal Float    // amount in ETB
  timeline          String   // e.g. "30 days"
  attachments       String   @default("") // JSON string of file URLs
  status            String   @default("pending_review") // pending_review, shortlisted, awarded, rejected
  rejectionNote     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tender  Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?
}

// ==========================================
// BID ANALYSIS (AI-generated)
// ==========================================

model BidAnalysis {
  id              String   @id @default(cuid())
  tenderId        String
  summary         String   @default("") // JSON: { totalBids, averageScore }
  rankings        String   @default("") // JSON: [{ rank, name, company, overallScore, ... }]
  budgetAnalysis  String   @default("") // AI budget analysis text
  recommendation  String   @default("") // Final recommendation
  riskSummary     String   @default("") // Overall risk assessment
  createdBy       String   // admin user id who triggered analysis
  createdAt       DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

// ==========================================
// PROJECT WORKSPACE
// ==========================================

model Project {
  id          String   @id @default(cuid())
  tenderId    String   @unique
  bidId       String   @unique
  companyId   String?  // company isolation: which company owns this project
  status      String   @default("active") // active, completed, on_hold, cancelled
  contractValue Float  // from bid financial proposal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tender    Tender    @relation(fields: [tenderId], references: [id])
  bid       Bid       @relation(fields: [bidId], references: [id])
  company   Company?  @relation(fields: [companyId], references: [id])
  tasks     Task[]
  payments  Payment[]
  chat      Chat?
  milestones Milestone[]

  @@index([companyId])
}

// ==========================================
// TASK (Kanban)
// ==========================================

model Task {
  id          String   @id @default(cuid())
  projectId   String
  companyId   String?  // company isolation: inherited from project
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, done
  assigneeId  String?  // user id of assigned team member
  dueDate     DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company  Company? @relation(fields: [companyId], references: [id])
  assignee User?    @relation(fields: [assigneeId], references: [id])

  @@index([companyId])
  @@index([assigneeId])
}

// ==========================================
// MILESTONE
// ==========================================

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==========================================
// FINANCIAL TRACKING
// ==========================================

model Payment {
  id              String   @id @default(cuid())
  projectId       String
  amount          Float
  paymentMethod   String   // bank_transfer, cbe_birr, cash, check
  referenceNumber String?
  notes           String?
  paymentDate     DateTime
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==========================================
// COMMUNICATION HUB
// ==========================================

model Chat {
  id          String   @id @default(cuid())
  projectId   String?  @unique
  tenderId    String?
  contextType String   // tender, project
  createdAt   DateTime @default(now())

  messages Message[]
  project  Project? @relation(fields: [projectId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  content   String
  flagged   Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// CAPACITY BUILDING (Workshops)
// ==========================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  eventDate   DateTime
  location    String
  capacity    Int
  status      String   @default("upcoming") // upcoming, ongoing, completed, cancelled
  category    String   @default("workshop") // workshop, training, seminar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations Registration[]
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ==========================================
// COMMENTS / TESTIMONIALS
// ==========================================

model Comment {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  role      String?  @default("contractor") // contractor, tender_owner, admin, other
  content   String
  rating    Int      @default(5) // 1-5 star rating
  featured  Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved, createdAt])
}

// ==========================================
// NOTIFICATION
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, alert
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ==========================================
// TELEGRAM-STYLE MESSAGING (Conversations, Groups, Channels)
// ==========================================

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("group") // direct, group, channel, project
  title       String?
  description String?
  avatarUrl   String?
  createdBy   String
  tenderId    String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ConversationMember[]
  messages ChatMessage[]

  @@index([type])
  @@index([tenderId])
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String   @default("member") // owner, admin, member
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime? @default(now())
  muted          Boolean  @default(false)
  pinned         Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  content        String
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  flagged        Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo      ChatMessage?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies      ChatMessage[] @relation("MessageReply")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
