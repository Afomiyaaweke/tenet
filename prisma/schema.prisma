generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("contractor")
  company   String?
  phone     String?
  createdAt DateTime @default(now())
  tenders   Tender[]
}

model Tender {
  id           String   @id @default(cuid())
  title        String
  organization String
  category     String
  deadline     DateTime
  budget       String
  description  String
  requirements String   @default("[]")
  location     String   @default("")
  status       String   @default("open")
  bidCount     Int      @default(0)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([userId])
  @@index([deadline])
}

model Comment {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  role      String   @default("other")
  content   String
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
  @@index([createdAt])
}
