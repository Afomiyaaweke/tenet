# ─── TenetBid Production Configuration ──────────────────────
# For 2000 concurrent users on tenet.space-z.ai
#
# IMPORTANT: Production secrets MUST be set in Vercel Dashboard → Project → Settings → Environment Variables
# This .env file is for local development only.

# ─── Database ────────────────────────────────────────────────
# Local dev: SQLite (stored in db/custom.db)
# Production: PostgreSQL (Neon, Supabase, or similar) — set in Vercel env vars
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Domain Configuration ────────────────────────────────────
# Primary domain for TenetBid
NEXT_PUBLIC_APP_URL=https://tenet.space-z.ai

# NextAuth URL — must match the domain users access the app through
NEXTAUTH_URL=https://tenet.space-z.ai

# Also allow localhost for local development
NEXTAUTH_URL_LOCAL=http://localhost:3000

# ─── Authentication ──────────────────────────────────────────
# JWT secret — MUST be changed in production! Generate with: openssl rand -base64 48
# Set a strong JWT_SECRET in Vercel Dashboard environment variables for production
JWT_SECRET=tenetbid-dev-secret-change-in-production-32ch-minimum

# ─── CORS ────────────────────────────────────────────────────
# Additional CORS origins (comma-separated) — for staging or other domains
# CORS_EXTRA_ORIGINS=https://staging.tenet.space-z.ai

# ─── File Storage ────────────────────────────────────────────
# In production, set BLOB_READ_WRITE_TOKEN from Vercel Blob store
# This enables Vercel Blob storage for file uploads instead of local filesystem
# BLOB_READ_WRITE_TOKEN=vercel_blob_token_from_vercel_dashboard

# ─── Email ───────────────────────────────────────────────────
# For production email delivery (password reset, notifications)
# Set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS in Vercel env vars
