GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub → Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra ID (Azure Portal → App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# LinkedIn OAuth (LinkedIn Developer Portal → My Apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# JWT Secret (generate with: openssl rand -base64 48)
JWT_SECRET=
