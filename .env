DATABASE_URL=file:/home/z/my-project/db/custom.db

# Email / SMTP — Required for password reset emails
# Configure these to send real emails. Without SMTP, reset codes
# are logged to the server console (dev mode only).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
# SMTP_FROM="Tenets <noreply@tenet.app>"

# Base URL of the app — used to build reset links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
