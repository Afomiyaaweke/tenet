DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Secrets (REQUIRED in production) ──────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Email / SMTP ─────────────────────────────────────────────────────────
# Required for password reset emails. Without SMTP, reset codes are
# logged to the server console (development mode only — NEVER in production).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
# SMTP_FROM="Tenets <noreply@tenet.app>"

# ── App URLs ──────────────────────────────────────────────────────────────
# Base URL of the app — used to build reset links in emails.
# Must use HTTPS in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
