NEXT_PUBLIC_CLARITY_ID=y3c26jfrzu

# App URL (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=https://tenetbid.vercel.app

# ── OAuth Provider Keys ──────────────────────────────────────────────
# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
