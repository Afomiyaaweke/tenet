# ──────────────────────────────────────────────────────────────
# Tenets Tender Ecosystem — Environment Variables
# ──────────────────────────────────────────────────────────────

# Database (SQLite for development; use PostgreSQL for production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# JWT Secret — MUST be set in production (min 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-in-production-with-openssl-rand-base64-48

# Node environment
NODE_ENV=development
