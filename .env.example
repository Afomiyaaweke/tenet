# ── Database ──────────────────────────────────────────────────────────────
# For local development with SQLite (default):
DATABASE_URL=file:./db/custom.db
# For production with PostgreSQL (e.g., Neon, Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# ── Authentication ───────────────────────────────────────────────────────
# ⚠️  CRITICAL: You MUST set JWT_SECRET in production!
# Generate a strong secret: openssl rand -base64 48
# Without this, sign-in and registration will FAIL in production.
JWT_SECRET=change-me-to-a-strong-secret-at-least-32-chars-long

# ── App URL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (optional — if not set, emails log to console) ─────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=TenetBid <noreply@tenetbid.com>
# EMAIL_FROM=TenetBid <noreply@tenetbid.com>

# ── File uploads (optional — for Vercel Blob in production) ──────────────
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
